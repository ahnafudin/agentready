# Generic rules only; `npm run stack:apply` adds framework artefacts in the managed block below.
# Ambiguous names (`bin/`, `obj/`, `out/`, `target/`) are left out: ignoring real source loses files silently.

# ── Secrets ───────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.keystore
*.jks
*.p12

# ── OS / editor junk ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ── Universal build / dependency output ───────────────────────────────────
node_modules/
dist/
coverage/
.cache/
*.log

# ── Python (unambiguous everywhere) ───────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/

# ── Vendored dependencies (root-scoped: PHP, Go, Ruby) ────────────────────
/vendor/
/.bundle/

# ── Toolchain caches ──────────────────────────────────────────────────────
.gradle/
local.properties
*.class
Pods/
DerivedData/

# Shared task worktrees and generated session context.
/.worktrees/
/.agentready-handoff.md
# Keep existing Claude-managed worktrees ignored.
.claude/worktrees/

# >>> tooling:stack-ignores
# Framework build artefacts — regenerated by `npm run stack:apply`.
node_modules/
dist/
coverage/
.turbo/
*.tsbuildinfo
# <<< tooling:stack-ignores
